# AI analysis and writing are off unless this value is exactly true.
# An enabled endpoint is not authenticated. Do not expose it on the public internet.
# Analysis and writing each have a process-local limit of 10 requests per 10 minutes.
# Those limits are only for local or private development.
# They are not sufficient protection for a public deployment.
AI_REVIEW_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
