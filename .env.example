# AI analysis is off unless this value is exactly true.
# An enabled endpoint is not authenticated. Do not expose it on the public internet.
# The process-local request limit is only for local or private development.
# It is not sufficient protection for a public deployment.
AI_REVIEW_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
